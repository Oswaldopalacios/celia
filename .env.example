# Postgres (Supabase) — usa Session pooler o Direct
# Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Misma URI en modo Direct (host db.XXXX.supabase.co:5432) para migraciones
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

SESSION_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
ADMIN_EMAIL="admin@donacelia.com"
ADMIN_PASSWORD="cambia-esta-contraseña"
ADMIN_NAME="Administrador"

# Dominio público (SEO, sitemap, previews al compartir)
NEXT_PUBLIC_SITE_URL="https://www.restaurantedonacelia.com.mx"

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
